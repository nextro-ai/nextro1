{
  "source": "https://lonsolab.com/assets/css/site.css?v=ebc38b9ffb (crawled 2026-10-05)",
  "color": {
    "papel": "#f3f4ef",
    "papel2": "#e8eae2",
    "blanco": "#ffffff",
    "tinta": "#13182b",
    "tinta2": "#4a5168",
    "linea": "#d3d7df",
    "cobalto": "#2340d8",
    "cobaltoHondo": "#182c9e",
    "cobaltoClaro": "#c9d2ff",
    "pin": "#ff5a26",
    "pinHondo": "#e8461a",
    "pinHover": "#ff7a4d",
    "secondary": {
      "tintaPanel": "#1b2137",
      "tintaPanelBorde": "#2f3650",
      "tintaChip": "#232a42",
      "tintaChipBorde": "#39405a",
      "textoSobreTinta": "#b9bfd3",
      "textoSobreTinta2": "#d8dcea",
      "pieTexto": "#c8ccda",
      "barraMaps": "#6f86ff",
      "iconoFondo": "#e4e9fb",
      "conmutadorFondo": "#e3e6ee",
      "buscadorFondo": "#eef0f5",
      "miniMapaFondo": "#e6ebf3",
      "miniMapaLineas": "#9fb0d8",
      "estrellas": "#e7a614",
      "llamadaVerde": "#22a35a",
      "whatsappVerde": "#1f9d55",
      "okVerde": "#1d7a3e",
      "okVerdeFondo": "#eaf6ee",
      "alertaRojo": "#b42318",
      "pinFondoSuave": "#fff4ef",
      "punteado": "#c9ced8",
      "terraFirmaArena": ["#f6efdf", "#e9dfc8", "#dccfb1"],
      "terraFirmaNegro": "#0d0c0a"
    }
  },
  "font": {
    "family": "Archivo",
    "variableAxes": { "wght": [100, 900], "wdth": [62, 125] },
    "body": { "weight": 400, "stretch": 100, "size": "1.0625rem", "lineHeight": 1.6 },
    "heading": { "weight": 780, "stretch": 108, "letterSpacing": "-0.03em", "lineHeight": 1.02 },
    "hero": { "weight": 820, "stretch": 112, "letterSpacing": "-0.04em", "lineHeight": 0.94 },
    "strong": { "weight": 680 },
    "button": { "weight": 680, "stretch": 104, "letterSpacing": "-0.005em" },
    "link": { "weight": 620 },
    "files": {
      "webVariable": "assets/brand/fonts/archivo-latin-var.woff2",
      "ttfVariable": "assets/brand/fonts/Archivo-Variable-latin.ttf",
      "ttfItalicVariable": "assets/brand/fonts/Archivo-Italic-Variable-latin.ttf",
      "latinExtWoff2": "assets/brand/fonts/fontsource-archivo-latin-ext-wdth-normal.woff2",
      "staticDir": "assets/brand/fonts/static/"
    }
  },
  "radius": { "radio": 18, "radioChico": 10, "pill": 999, "panel": 24, "chip": 14, "button": 999 },
  "shadow": {
    "panel": "0 1px 2px rgb(19 24 43 / 0.06), 0 24px 48px -24px rgb(19 24 43 / 0.32)",
    "flotante": "0 2px 6px rgb(19 24 43 / 0.08), 0 18px 36px -18px rgb(19 24 43 / 0.4)",
    "botonPin": "0 10px 20px -12px rgb(19 24 43 / 0.45)",
    "planDestacado": "0 30px 60px -30px rgb(35 64 216 / 0.7)"
  },
  "easing": {
    "salida": "cubic-bezier(0.16, 1, 0.3, 1)",
    "rebote": "cubic-bezier(0.34, 1.4, 0.5, 1)"
  },
  "motion": {
    "estirar": "font-stretch 68% -> 112%, opacity 0 -> 1, translateY(0.18em) -> 0, blur(6px) -> 0; 1.3s salida; lines staggered 0 / 0.08 / 0.3 / 0.38s ('la tipografía se expande, como algo que despega')",
    "aparecer": "opacity 0 -> 1, translateY(14px) -> 0; 0.9s salida",
    "trazar": "topo stroke-dashoffset 2400 -> 0; 3.2s salida",
    "parpadeo": "search cursor blink 1s steps(1)",
    "sonar": "phone icon wiggle 0/-12/10/-6deg",
    "onda": "pin ripple: rotate(45deg) scale(0.6 -> 2.4), opacity .9 -> 0"
  }
}
